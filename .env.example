# Copy this file to .env and fill in your values

# AssemblyAI — for transcription (same key as the main webapp)
ASSEMBLYAI_API_KEY=your_assemblyai_key_here

# Anthropic — for manuscript generation (same key as the main pipeline)
ANTHROPIC_API_KEY=your_anthropic_key_here

# Claude model to use for manuscript generation
CLAUDE_MODEL=claude-sonnet-4-6

# Output folders (video/transcript/manuscript) are configured from the app's
# /settings page after first run, not here — see CLAUDE.md.

# Flask session secret — change this to something random
SECRET_KEY=change-me-to-a-random-string
