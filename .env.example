# Copy this file to .env and fill in your values

# AssemblyAI — for transcription (same key as the main webapp)
ASSEMBLYAI_API_KEY=your_assemblyai_key_here

# Anthropic — for manuscript generation (same key as the main pipeline)
ANTHROPIC_API_KEY=your_anthropic_key_here

# Claude model to use for manuscript generation
CLAUDE_MODEL=claude-sonnet-4-6

# Output directory — where videos, transcripts, and manuscripts are saved
OUTPUT_DIR=E:\Trumpters Call Mar-May 2026

# Flask session secret — change this to something random
SECRET_KEY=change-me-to-a-random-string
